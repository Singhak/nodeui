{
  "name": "@singhak/nodeui-hono",
  "version": "0.3.1",
  "description": "Hono middleware adapter (Node runtime) for the NodeUI developer console.",
  "license": "Apache-2.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "hono",
    "middleware",
    "console",
    "developer-tools",
    "observability",
    "debugging"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Singhak/nodeui.git"
  },
  "homepage": "https://github.com/Singhak/nodeui#readme",
  "bugs": {
    "url": "https://github.com/Singhak/nodeui/issues"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@singhak/nodeui-core": "^0.3.1"
  },
  "peerDependencies": {
    "hono": "^4.0.0",
    "@hono/node-server": "^1.19.0"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.0",
    "@types/node": "^22.19.0",
    "hono": "^4.6.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "author": "Anil Kumar",
  "type": "commonjs"
}
