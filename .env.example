# NodeUI - Local Developer Console
#
# Copy to .env and adjust as needed. No real secrets are ever committed.
#
# Activation. The console is activated when NODEUI_ENABLED=true OR when
# NODE_ENV is not "production". In production with NODEUI_ENABLED unset the
# console is unavailable (fail-closed).
NODEUI_ENABLED=
# Interface to bind. Defaults to loopback only.
NODEUI_HOST=127.0.0.1
# Informational: the port the host application listens on. The console is
# mounted on the host application's path, so no separate port is opened.
NODEUI_PORT=3000
# URL path prefix where the console and its API are served.
NODEUI_PATH=/nodeui
# Fixed-size ring buffer for the HTTP request log.
NODEUI_REQUEST_LOG_SIZE=500
# Polling interval (ms) used by the UI and the sampling providers.
NODEUI_POLL_INTERVAL_MS=2000
